#!/usr/bin/env bash
# SkillForge pipeline CLI — runs the data pipeline from anywhere.
# For real Forge training, point PYTHON at the MLX interpreter and put its bin
# on PATH so mlx_lm.lora / mlx_lm.server are discoverable:
#   PYTHON=/path/to/mlx-env/bin/python PATH=/path/to/mlx-env/bin:$PATH ./sf serve
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${PYTHON:-python3}"
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m pipeline "$@"
